+func writeGPGListing(t *testing.T, bin, listing string) {
+	t.Helper()
+	command := "#!/bin/sh\nprintf '%s' '" + strings.ReplaceAll(listing, "'", "'\\''") + "'\n"
+	if err := os.WriteFile(filepath.Join(bin, "gpg"), []byte(command), 0700); err != nil {
+		t.Fatal(err)
+	}
+}
