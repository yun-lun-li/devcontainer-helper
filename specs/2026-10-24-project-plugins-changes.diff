+				return Result{}, err
+			}
+			return Result{NeedsBuild: true}, nil
+		}
+		return Result{}, nil
+	}
+	beta := &fakePlugin{definition: Definition{ID: "beta"}}
+	cleanupFails := true
+	beta.host = func(_ context.Context, host HostContext, event Event) (Result, error) {
