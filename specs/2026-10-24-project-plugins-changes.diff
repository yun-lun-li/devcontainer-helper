+	wantMount := "source=/run/user/1000/dch/project,target=/run/dch-github,type=bind,readonly"
+	if !reflect.DeepEqual(config.Mounts, []string{wantMount}) {
+		t.Fatalf("mounts = %#v, want %#v", config.Mounts, []string{wantMount})
