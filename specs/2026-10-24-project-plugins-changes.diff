+++ b/internal/githubapp/server_test.go
@@ -0,0 +1,186 @@
+package githubapp
+
+import (
+	"context"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestServerServesCredentialAndHealthOnlyOverUnixSocket(t *testing.T) {
+	sock := filepath.Join(t.TempDir(), "credential.sock")
+	if err := os.Chmod(filepath.Dir(sock), 0700); err != nil {
+		t.Fatal(err)
+	}
+	cfg := Config{AppID: 1, InstallationID: 2, PrivateKeyPassEntry: "key", Repository: "octo/repo", Permissions: map[string]string{"contents": "read"}}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	go func() { _ = Serve(ctx, sock, cfg) }()
+	waitForSocket(t, sock)
+	socketInfo, err := os.Stat(sock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if socketInfo.Mode().Perm() != 0600 {
+		t.Fatalf("socket mode = %o", socketInfo.Mode().Perm())
+	}
+	client := unixHTTPClient(sock)
+	resp, err := client.Get("http://unix/health")
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		t.Fatalf("health status = %d", resp.StatusCode)
+	}
+	resp, err = client.Get("http://unix/credential")
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, _ := io.ReadAll(resp.Body)
+	resp.Body.Close()
+	if resp.StatusCode != http.StatusServiceUnavailable || !strings.Contains(resp.Header.Get("Cache-Control"), "no-store") {
+		t.Fatalf("credential response status=%d headers=%v body=%q", resp.StatusCode, resp.Header, data)
+	}
+	resp, err = client.Get("http://unix/other")
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+	if resp.StatusCode != http.StatusNotFound {
+		t.Fatalf("other path status = %d", resp.StatusCode)
+	}
+	request, _ := http.NewRequest(http.MethodPost, "http://unix/health", nil)
+	resp, err = client.Do(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+	if resp.StatusCode != http.StatusMethodNotAllowed {
+		t.Fatalf("health POST status = %d", resp.StatusCode)
+	}
+	if err := Serve(context.Background(), sock, cfg); err == nil {
+		t.Fatal("second server acquired the active socket")
+	}
+	cancel()
+	waitForSocketRemoval(t, sock)
+}
+
+func TestServerRecoversStaleSocketAfterCrash(t *testing.T) {
+	sock := filepath.Join(t.TempDir(), "credential.sock")
+	_ = os.Chmod(filepath.Dir(sock), 0700)
+	stale, err := net.Listen("unix", sock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	stale.(*net.UnixListener).SetUnlinkOnClose(false)
+	if err := stale.Close(); err != nil {
+		t.Fatal(err)
+	}
+	cfg := Config{AppID: 1, InstallationID: 2, PrivateKeyPassEntry: "key", Repository: "octo/repo", Permissions: map[string]string{"contents": "read"}}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	result := make(chan error, 1)
+	go func() { result <- Serve(ctx, sock, cfg) }()
+	waitForHealth(t, sock)
+	cancel()
+	waitForSocketRemoval(t, sock)
+	if err := <-result; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestRuntimeDirUsesPrivateProjectSpecificDirectory(t *testing.T) {
+	runtime := t.TempDir()
+	if err := os.Chmod(runtime, 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("XDG_RUNTIME_DIR", runtime)
+	a, err := RuntimeDir("/workspace/one")
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := RuntimeDir("/workspace/two")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if a == b || !strings.HasPrefix(a, runtime) {
+		t.Fatalf("unexpected paths %q %q", a, b)
+	}
+	info, err := os.Stat(a)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != 0700 {
+		t.Fatalf("mode = %o", info.Mode().Perm())
+	}
+}
+
+func TestCheckCredentialUsesUnixSocket(t *testing.T) {
+	sock := filepath.Join(t.TempDir(), "health.sock")
+	listener, err := net.Listen("unix", sock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	server := &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/credential" {
+			t.Errorf("path=%s", r.URL.Path)
+		}
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte("token"))
+	})}
+	go server.Serve(listener)
+	defer server.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if err := CheckCredential(ctx, sock); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func waitForSocket(t *testing.T, path string) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		if _, err := os.Stat(path); err == nil {
+			return
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatal("socket did not appear")
+}
+
+func waitForSocketRemoval(t *testing.T, path string) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		if _, err := os.Lstat(path); os.IsNotExist(err) {
+			return
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatal("socket was not removed")
+}
+
+func waitForHealth(t *testing.T, path string) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	client := unixHTTPClient(path)
+	for time.Now().Before(deadline) {
+		resp, err := client.Get("http://unix/health")
+		if err == nil {
+			resp.Body.Close()
+			if resp.StatusCode == http.StatusOK {
+				return
+			}
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatal("credential server did not become healthy")
+}
diff --git a/internal/plugins/manager.go b/internal/plugins/manager.go
new file mode 100644
index 0000000..8840cf5
--- /dev/null
+++ b/internal/plugins/manager.go
@@ -0,0 +1,715 @@
+package plugins
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"time"
+
+	"dch/internal/common"
+	"dch/internal/githubapp"
+)
+
+const githubAppID = "github-app"
+
+type Status struct {
+	Enabled       bool
+	PendingBuild  bool
+	ServiceActive bool
+	Message       string
+}
+
+type Manager struct{}
+
+func NewManager() *Manager { return &Manager{} }
+
+func (m *Manager) Enable(ctx context.Context, projectPath string, cfg githubapp.Config) error {
+	if err := cfg.Validate(); err != nil {
+		return err
+	}
+	path, err := common.NormalizePath(projectPath)
+	if err != nil {
+		return err
+	}
+	unlock, err := lockConfig()
+	if err != nil {
+		return err
+	}
+	defer unlock()
+
+	config, err := common.LoadConfig()
+	if err != nil {
+		return err
+	}
+	old, hadOld := config.ProjectPlugins[path]
+	if err := validateEnabledPlugins(old); err != nil {
+		return err
+	}
+	_, wasEnabled := old.Enabled[githubAppID]
+	wasActive, _ := m.serviceActive(ctx, path)
+	fragment, runtimeDir, err := renderFragment(path)
+	if err != nil {
+		return err
+	}
+	fragmentPath, oldBytes, oldFileExists, err := replaceManagedFragment(path, fragment, old.States[githubAppID].FragmentDigest)
+	if err != nil {
+		return err
+	}
+	if err := githubapp.WriteAdapterScripts(runtimeDir); err != nil {
+		return errors.Join(err, restoreFile(fragmentPath, oldBytes, oldFileExists))
+	}
+	unit, err := m.prepareServiceUnit(path, old.States[githubAppID])
+	if err != nil {
+		return errors.Join(err, restoreFile(fragmentPath, oldBytes, oldFileExists))
+	}
+
+	if err := saveEnabledPlugin(config, path, old, cfg, fragment, unit); err != nil {
+		cleanupErr := restoreFile(fragmentPath, oldBytes, oldFileExists)
+		cleanupErr = errors.Join(cleanupErr, unit.restore())
+		return errors.Join(err, cleanupErr)
+	}
+
+	rollback := enableRollback{manager: m, path: path, old: old, hadOld: hadOld, wasEnabled: wasEnabled, wasActive: wasActive, fragmentPath: fragmentPath, oldBytes: oldBytes, oldFileExists: oldFileExists, runtimeDir: runtimeDir, unit: unit}
+
+	return m.activateEnabledPlugin(ctx, path, runtimeDir, wasActive && wasEnabled, rollback)
+}
+
+func (m *Manager) activateEnabledPlugin(ctx context.Context, path, runtimeDir string, restart bool, rollback enableRollback) error {
+	if err := runSystemctl(ctx, "daemon-reload"); err != nil {
+		return rollback.run(err, false)
+	}
+	if restart {
+		if err := runSystemctl(ctx, "restart", unitName(path)); err != nil {
+			return rollback.run(err, true)
+		}
+	} else if err := runSystemctl(ctx, "enable", "--now", unitName(path)); err != nil {
+		return rollback.run(err, true)
+	}
+	if err := m.checkReady(ctx, runtimeDir); err != nil {
+		return rollback.run(err, true)
+	}
+	return nil
+}
+
+func (m *Manager) Ensure(ctx context.Context, projectPath string) error {
+	path, err := common.NormalizePath(projectPath)
+	if err != nil {
+		return err
+	}
+	unlock, err := lockConfig()
+	if err != nil {
+		return err
+	}
+	defer unlock()
+	config, err := common.LoadConfig()
+	if err != nil {
+		return err
+	}
+	project, ok := config.ProjectPlugins[path]
+	if !ok {
+		return nil
+	}
+	if err := validateEnabledPlugins(project); err != nil {
+		return err
+	}
+	_, enabled := project.Enabled[githubAppID]
+	if !enabled {
+		return nil
+	}
+	if err := validateManagedFragment(path, project.States[githubAppID].FragmentDigest); err != nil {
+		return err
+	}
+	runtimeDir, unit, err := m.prepareEnsureService(path, project)
+	if err != nil {
+		return err
+	}
+	oldState := project.States[githubAppID]
+	state := oldState
+	state.UnitDigest = unit.digest
+	state.UnitPath = unit.path
+	metadataChanged := state != oldState
+	if metadataChanged {
+		project.States[githubAppID] = state
+		config.ProjectPlugins[path] = project
+		if err := common.SaveConfig(config); err != nil {
+			return errors.Join(err, unit.restore())
+		}
+	}
+	active, _ := m.serviceActive(ctx, path)
+	rollback := ensureRollback{unit: unit, metadataChanged: metadataChanged, project: project, config: config, path: path, oldState: oldState}
+	if err := activateEnsuredPlugin(ctx, path, active, unit, rollback); err != nil {
+		return err
+	}
+	return m.checkReady(ctx, runtimeDir)
+}
+
+func activateEnsuredPlugin(ctx context.Context, path string, active bool, unit serviceUnitChange, rollback ensureRollback) error {
+	if err := runSystemctl(ctx, "daemon-reload"); err != nil {
+		return rollback.run(err)
+	}
+	if active && unit.changed {
+		if err := runSystemctl(ctx, "restart", unitName(path)); err != nil {
+			return rollback.run(err)
+		}
+	} else if err := runSystemctl(ctx, "enable", "--now", unitName(path)); err != nil {
+		return rollback.run(err)
+	}
+	return nil
+}
+
+func validateManagedFragment(path, expectedDigest string) error {
+	_, exists, err := readOwnedFile(managedFragment(path), expectedDigest)
+	if err != nil {
+		return err
+	}
+	if !exists {
+		return fmt.Errorf("managed plugin fragment is missing")
+	}
+	return nil
+}
+
+func (m *Manager) prepareEnsureService(path string, project common.ProjectPlugins) (string, serviceUnitChange, error) {
+	_, runtimeDir, err := renderFragment(path)
+	if err != nil {
+		return "", serviceUnitChange{}, err
+	}
+	if err := githubapp.WriteAdapterScripts(runtimeDir); err != nil {
+		return "", serviceUnitChange{}, err
+	}
+	unit, err := m.prepareServiceUnit(path, project.States[githubAppID])
+	return runtimeDir, unit, err
+}
