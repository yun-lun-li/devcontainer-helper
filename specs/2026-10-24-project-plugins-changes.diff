+	configHome := filepath.Join(root, "config-home")
+	if err := os.Mkdir(configHome, 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", bin+string(os.PathListSeparator)+os.Getenv("PATH"))
+	t.Setenv("XDG_RUNTIME_DIR", runtime)
