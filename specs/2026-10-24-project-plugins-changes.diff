+
+func TestGHWrapperReportsMissingUnderlyingGHBeforeRequestingCredential(t *testing.T) {
+	runtimeDir := t.TempDir()
+	if err := os.Chmod(runtimeDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := WriteAdapterScripts(runtimeDir); err != nil {
