+	if err := os.WriteFile(filepath.Join(bin, "systemctl"), []byte("#!/bin/sh\nshift\nif [ \"$1\" = stop ]; then echo stop-denied >&2; exit 1; fi\nexit 0\n"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	runtime, err := os.MkdirTemp("/tmp", "dchrt")
+	if err != nil {
+		t.Fatal(err)
+	}
