+func TestProviderCoalescesConcurrentMints(t *testing.T) {
+	key := testPrivateKey(t)
+	var calls atomic.Int32
+	release := make(chan struct{})
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/app/installations/2/access_tokens" {
+			calls.Add(1)
+			<-release
+			_, _ = w.Write([]byte(`{"token":"shared-token","expires_at":"2030-01-01T00:00:00Z"}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"id":2}`))
+	}))
+	defer srv.Close()
+	pass := filepath.Join(t.TempDir(), "pass")
+	_ = os.WriteFile(pass, []byte("#!/bin/sh\ncat <<'KEY'\n"+key+"\nKEY\n"), 0700)
+	p, err := NewProvider(Config{AppID: 1, InstallationID: 2, PrivateKeyPassEntry: "key", Repository: "octo/repo", Permissions: map[string]string{"contents": "read"}}, ProviderOptions{PassPath: pass, APIBaseURL: srv.URL, HTTPClient: srv.Client()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	errs := make(chan error, 12)
+	for i := 0; i < 12; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			token, err := p.Token(context.Background())
+			if err == nil && token != "shared-token" {
+				err = fmt.Errorf("token=%q", token)
+			}
+			errs <- err
+		}()
+	}
+	time.Sleep(25 * time.Millisecond)
+	close(release)
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		if err != nil {
+			t.Error(err)
+		}
+	}
+	if calls.Load() != 1 {
+		t.Fatalf("mint calls=%d", calls.Load())
+	}
+}
+
+func TestProviderCoalescesConcurrentFailureAndAllowsLaterRetry(t *testing.T) {
+	key := testPrivateKey(t)
+	var calls atomic.Int32
+	release := make(chan struct{})
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/app/installations/2/access_tokens" {
+			if calls.Add(1) == 1 {
+				<-release
+				http.Error(w, "private API details", http.StatusTooManyRequests)
+				return
+			}
+			_, _ = w.Write([]byte(`{"token":"recovered-token","expires_at":"2030-01-01T00:00:00Z"}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"id":2}`))
+	}))
+	defer srv.Close()
+	pass := filepath.Join(t.TempDir(), "pass")
+	_ = os.WriteFile(pass, []byte("#!/bin/sh\ncat <<'KEY'\n"+key+"\nKEY\n"), 0700)
+	p, err := NewProvider(Config{AppID: 1, InstallationID: 2, PrivateKeyPassEntry: "key", Repository: "octo/repo", Permissions: map[string]string{"contents": "read"}}, ProviderOptions{PassPath: pass, APIBaseURL: srv.URL, HTTPClient: srv.Client()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	errs := make(chan error, 8)
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() { defer wg.Done(); _, err := p.Token(context.Background()); errs <- err }()
+	}
+	time.Sleep(25 * time.Millisecond)
+	close(release)
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		if err == nil {
+			t.Error("expected shared failed refresh")
+		}
+	}
+	if calls.Load() != 1 {
+		t.Fatalf("concurrent failed mint calls=%d", calls.Load())
+	}
+	got, err := p.Token(context.Background())
+	if err != nil || got != "recovered-token" {
+		t.Fatalf("retry = %q, %v", got, err)
+	}
+}
+
+func testProviderRefresh(t *testing.T, now time.Time, expectedCalls int32) {
+	t.Helper()
+	key := testPrivateKey(t)
+	var calls atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/app/installations/2/access_tokens" {
+			count := calls.Add(1)
+			if count == 1 {
+				_, _ = w.Write([]byte(`{"token":"refresh-token","expires_at":"2030-01-01T00:00:00Z"}`))
+			} else {
+				_, _ = w.Write([]byte(`{"token":"refresh-token-2","expires_at":"2030-01-01T01:00:00Z"}`))
+			}
+			return
+		}
+		_, _ = w.Write([]byte(`{"id":2}`))
+	}))
+	defer srv.Close()
+	pass := filepath.Join(t.TempDir(), "pass")
+	_ = os.WriteFile(pass, []byte("#!/bin/sh\ncat <<'KEY'\n"+key+"\nKEY\n"), 0700)
+	current := now
+	p, err := NewProvider(Config{AppID: 1, InstallationID: 2, PrivateKeyPassEntry: "key", Repository: "octo/repo", Permissions: map[string]string{"contents": "read"}}, ProviderOptions{PassPath: pass, APIBaseURL: srv.URL, HTTPClient: srv.Client(), Now: func() time.Time { return current }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = p.Token(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	current = current.Add(time.Minute)
+	_, err = p.Token(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if calls.Load() != expectedCalls {
+		t.Fatalf("mint calls=%d want %d", calls.Load(), expectedCalls)
+	}
+}
diff --git a/internal/githubapp/runtime.go b/internal/githubapp/runtime.go
new file mode 100644
index 0000000..1ec1dc3
--- /dev/null
+++ b/internal/githubapp/runtime.go
@@ -0,0 +1,51 @@
+package githubapp
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"os"
+	"path/filepath"
+	"syscall"
+)
+
+func RuntimeDir(projectPath string) (string, error) {
+	runtime := os.Getenv("XDG_RUNTIME_DIR")
+	if runtime == "" {
+		return "", fmt.Errorf("XDG_RUNTIME_DIR is required")
+	}
+	info, err := os.Lstat(runtime)
+	if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || !ownedByCurrentUser(info) || info.Mode().Perm()&0077 != 0 {
+		return "", fmt.Errorf("XDG_RUNTIME_DIR is not a private directory owned by the current user")
+	}
+	abs, err := filepath.Abs(projectPath)
+	if err != nil || projectPath == "" {
+		return "", fmt.Errorf("invalid project path")
+	}
+	key := sha256.Sum256([]byte(filepath.Clean(abs)))
+	dir := filepath.Join(runtime, "dch", hex.EncodeToString(key[:12]))
+	parent := filepath.Join(runtime, "dch")
+	if err := ensurePrivateDir(parent); err != nil {
+		return "", err
+	}
+	if err := ensurePrivateDir(dir); err != nil {
+		return "", err
+	}
+	return dir, nil
+}
+
+func ensurePrivateDir(path string) error {
+	if err := os.Mkdir(path, 0700); err != nil && !os.IsExist(err) {
+		return fmt.Errorf("cannot create runtime directory")
+	}
+	info, err := os.Lstat(path)
+	if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || !ownedByCurrentUser(info) || info.Mode().Perm() != 0700 {
+		return fmt.Errorf("runtime directory is unsafe")
+	}
+	return nil
+}
+
+func ownedByCurrentUser(info os.FileInfo) bool {
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	return ok && int(stat.Uid) == os.Getuid()
+}
diff --git a/internal/githubapp/server.go b/internal/githubapp/server.go
new file mode 100644
index 0000000..5073141
--- /dev/null
+++ b/internal/githubapp/server.go
@@ -0,0 +1,176 @@
+package githubapp
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"time"
+)
+
+func Serve(ctx context.Context, socketPath string, cfg Config) error {
+	listener, provider, releaseLock, err := prepareCredentialSocket(socketPath, cfg)
+	if err != nil {
+		return err
+	}
+	defer releaseLock()
+	server := &http.Server{Handler: credentialMux(provider), ReadHeaderTimeout: 5 * time.Second}
+	return serveUntilCancelled(ctx, server, listener, socketPath)
+}
+
+func prepareCredentialSocket(socketPath string, cfg Config) (net.Listener, *Provider, func(), error) {
+	if err := cfg.Validate(); err != nil {
+		return nil, nil, nil, err
+	}
+	if len(socketPath) > 100 {
+		return nil, nil, nil, fmt.Errorf("socket path is too long")
+	}
+	parentInfo, err := os.Lstat(filepath.Dir(socketPath))
+	if err != nil || !parentInfo.IsDir() || parentInfo.Mode()&os.ModeSymlink != 0 || !ownedByCurrentUser(parentInfo) || parentInfo.Mode().Perm() != 0700 {
+		return nil, nil, nil, fmt.Errorf("socket directory is unsafe")
+	}
+	releaseLock, err := acquireServerLock(socketPath + ".lock")
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	listener, provider, err := listenCredentialSocket(socketPath, cfg)
+	if err != nil {
+		releaseLock()
+		return nil, nil, nil, err
+	}
+	return listener, provider, releaseLock, nil
+}
+
+func listenCredentialSocket(socketPath string, cfg Config) (net.Listener, *Provider, error) {
+	if info, err := os.Lstat(socketPath); err == nil {
+		if info.Mode()&os.ModeSocket == 0 {
+			return nil, nil, fmt.Errorf("socket path is unsafe")
+		}
+		if err := os.Remove(socketPath); err != nil {
+			return nil, nil, fmt.Errorf("cannot remove stale socket")
+		}
+	} else if !os.IsNotExist(err) {
+		return nil, nil, err
+	}
+	listener, err := net.Listen("unix", socketPath)
+	if err != nil {
+		return nil, nil, fmt.Errorf("cannot listen on credential socket")
+	}
+	if err := os.Chmod(socketPath, 0600); err != nil {
+		listener.Close()
+		os.Remove(socketPath)
+		return nil, nil, fmt.Errorf("cannot secure credential socket")
+	}
+	provider, err := NewProvider(cfg)
+	if err != nil {
+		listener.Close()
+		os.Remove(socketPath)
+		return nil, nil, err
+	}
+	return listener, provider, nil
+}
+
+func credentialMux(provider *Provider) *http.ServeMux {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/health", healthHandler)
+	mux.HandleFunc("/credential", credentialHandler(provider))
+	return mux
+}
+
+func healthHandler(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+	w.WriteHeader(http.StatusOK)
+	_, _ = io.WriteString(w, "ok\n")
+}
+
+func credentialHandler(provider *Provider) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Cache-Control", "no-store")
+		if r.Method != http.MethodGet {
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		token, err := provider.Token(r.Context())
+		if err != nil {
+			http.Error(w, "credential unavailable", http.StatusServiceUnavailable)
+			return
+		}
+		w.Header().Set("Content-Type", "text/plain; charset=utf-8")
+		_, _ = io.WriteString(w, token)
+	}
+}
+
+func serveUntilCancelled(ctx context.Context, server *http.Server, listener net.Listener, socketPath string) error {
+	done := make(chan struct{})
+	go func() {
+		select {
+		case <-ctx.Done():
+			_ = server.Close()
+		case <-done:
+		}
+	}()
+	err := server.Serve(listener)
+	close(done)
+	_ = os.Remove(socketPath)
+	if err == http.ErrServerClosed {
+		return nil
+	}
+	return fmt.Errorf("credential server failed")
+}
+
+func acquireServerLock(path string) (func(), error) {
+	fd, err := syscall.Open(path, syscall.O_CREAT|syscall.O_RDWR|syscall.O_CLOEXEC|syscall.O_NOFOLLOW, 0600)
+	if err != nil {
+		return nil, fmt.Errorf("cannot open credential server lock")
+	}
+	file := os.NewFile(uintptr(fd), path)
+	info, err := file.Stat()
+	if err != nil || !info.Mode().IsRegular() || !ownedByCurrentUser(info) {
+		file.Close()
+		return nil, fmt.Errorf("credential server lock is unsafe")
+	}
+	if err := file.Chmod(0600); err != nil {
+		file.Close()
+		return nil, fmt.Errorf("cannot secure credential server lock")
+	}
+	if err := syscall.Flock(fd, syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
+		file.Close()
+		return nil, fmt.Errorf("credential server is already running")
+	}
+	return func() { _ = syscall.Flock(fd, syscall.LOCK_UN); _ = file.Close() }, nil
+}
+
+func CheckCredential(ctx context.Context, socketPath string) error {
+	client := unixHTTPClient(socketPath)
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, "http://unix/credential", nil)
+	if err != nil {
+		return fmt.Errorf("cannot check credential service")
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		return fmt.Errorf("credential service unavailable")
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("credential service rejected check")
+	}
+	data, err := io.ReadAll(io.LimitReader(resp.Body, maxResponseBytes+1))
+	if err != nil || len(data) == 0 || len(data) > maxResponseBytes || strings.ContainsAny(string(data), "\r\n") {
+		return fmt.Errorf("credential service returned invalid token")
+	}
+	return nil
+}
+
+func unixHTTPClient(path string) *http.Client {
+	return &http.Client{Timeout: 20 * time.Second, Transport: &http.Transport{DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "unix", path)
+	}}, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+}
diff --git a/internal/githubapp/server_test.go b/internal/githubapp/server_test.go
new file mode 100644
index 0000000..9252176
