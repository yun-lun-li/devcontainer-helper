+	}
+	if err := manager.MarkBuilt(context.Background(), project); err != nil {
+		t.Fatal(err)
+	}
+	status, err = manager.Status(context.Background(), project)
+	if err != nil || status.PendingBuild {
+		t.Fatalf("pending state after MarkBuilt = %#v, %v", status, err)
+	}
