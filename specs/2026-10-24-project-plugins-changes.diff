de--rect" data-key="Host hook" data-step="4"><rect class="am-node-shape" x="783.4" y="85" width="88.6" height="35" rx="3"/><text x="827.7" y="102.5" text-anchor="middle" dominant-baseline="central" class="am-node-text">Host hook</text></g><g class="am-node am-node--rect" data-key="Container hook" data-step="5"><rect class="am-node-shape" x="768.3" y="14" width="118.7" height="35" rx="3"/><text x="827.7" y="31.5" text-anchor="middle" dominant-baseline="central" class="am-node-text">Container hook</text></g><g class="am-node am-node--rect" data-key="devcontainer exec" data-step="6"><rect class="am-node-shape" x="1002.6" y="14" width="139" height="35" rx="3"/><text x="1072.1" y="31.5" text-anchor="middle" dominant-baseline="central" class="am-node-text">devcontainer exec</text></g></g></svg></figure>
+<div class="am-tree"><div class="am-tree-cols am-tree-cols--free" style="--n: 2"><div class="am-tree-col"><div class="am-tree-box" data-key="internal/" data-step="0">internal/</div><ul class="am-tree-list"><li data-key="plugins/" data-step="1"><span class="am-tree-label">plugins/</span><ul><li data-key="plugin.go" data-step="2"><span class="am-tree-label">plugin.go</span><span class="am-tree-sub">Plugin 與可選 HostService 公開契約</span></li><li data-key="manager.go" data-step="3"><span class="am-tree-label">manager.go</span><span class="am-tree-sub">通用註冊、分派與狀態協調</span></li><li data-key="manager_test.go" data-step="4"><span class="am-tree-label">manager_test.go</span><span class="am-tree-sub">兩個測試用 plugin 驗證通用行為</span></li><li data-key="githubapp/" data-step="5"><span class="am-tree-label">githubapp/</span><ul><li data-key="config.go" data-step="6"><span class="am-tree-label">config.go</span><span class="am-tree-sub">GitHub 表單、參數與權限驗證</span></li><li data-key="plugin.go" data-step="7"><span class="am-tree-label">plugin.go</span><span class="am-tree-sub">Plugin 實作與事件對應</span></li><li data-key="manager.go" data-step="8"><span class="am-tree-label">manager.go</span><span class="am-tree-sub">原 manager 中的 GitHub 專屬協調</span></li><li data-key="service.go" data-step="9"><span class="am-tree-label">service.go</span><span class="am-tree-sub">systemd、Socket 與 ServeHost</span></li><li data-key="adapter.go" data-step="10"><span class="am-tree-label">adapter.go</span><span class="am-tree-sub">Git helper、gh wrapper 與初始化</span></li><li data-key="provider.go" data-step="11"><span class="am-tree-label">provider.go</span><span class="am-tree-sub">pass、JWT 與 GitHub API</span></li><li data-key="server.go" data-step="12"><span class="am-tree-label">server.go</span><span class="am-tree-sub">HTTP over Unix Socket</span></li><li data-key="runtime.go" data-step="13"><span class="am-tree-label">runtime.go</span><span class="am-tree-sub">GitHub runtime 路徑與檔案安全</span></li><li data-key="tests" data-ste