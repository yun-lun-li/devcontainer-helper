+		encoded, err := json.Marshal(item)
+		if err != nil {
+			// Values decoded from JSON are always marshalable.
+			continue
+		}
+		key := string(encoded)
+		if _, exists := seen[key]; exists {
+			continue
+		}
+		seen[key] = struct{}{}
+		merged = append(merged, item)
+	}
+	return merged
+}
