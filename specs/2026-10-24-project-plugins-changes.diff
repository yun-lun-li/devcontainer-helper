"18" rx="3"/><text x="1044.9" y="64.8" text-anchor="middle" dominant-baseline="central">JWT 換 Installation Token</text></g></g><g data-step="8"><path class="am-edge" d="M1151,33 L1097.9,28 Q1044.9,23 962,23 Q879.1,23 834.6,23 Q790.1,23 760.2,39.3 L730.3,55.5" marker-end="url(#am2-arrow)"/><g class="am-edge-label"><rect x="815.3" y="14" width="127.5" height="18" rx="3"/><text x="879.1" y="23" text-anchor="middle" dominant-baseline="central">Token 留在記憶體快取</text></g></g><g data-step="9"><path class="am-edge" d="M629.3,64.9 L583.3,59.4 Q537.2,54 491.1,59.6 L445.1,65.2" marker-end="url(#am2-arrow)"/><g class="am-edge-label"><rect x="502.2" y="45" width="70" height="18" rx="3"/><text x="537.2" y="54" text-anchor="middle" dominant-baseline="central">短期 Token</text></g></g></g><g><g class="am-node am-node--rect" data-key="Git 指令" data-step="0"><rect class="am-node-shape" x="14.3" y="91" width="77.4" height="35" rx="3"/><text x="53" y="108.5" text-anchor="middle" dominant-baseline="central" class="am-node-text">Git 指令</text></g><g class="am-node am-node--rect" data-key="Credential Helper" data-step="0"><rect class="am-node-shape" x="137.9" y="91" width="132.8" height="35" rx="3"/><text x="204.3" y="108.5" text-anchor="middle" dominant-baseline="central" class="am-node-text">Credential Helper</text></g><g class="am-node am-node--rect" data-key="curl Unix Socket" data-step="1"><rect class="am-node-shape" x="316.7" y="55.5" width="128.4" height="35" rx="3"/><text x="380.9" y="73" text-anchor="middle" dominant-baseline="central" class="am-node-text">curl Unix Socket</text></g><g class="am-node am-node--rect" data-key="GH 指令" data-step="2"><rect class="am-node-shape" x="14" y="20" width="77.9" height="35" rx="3"/><text x="53" y="37.5" text-anchor="middle" dominant-baseline="central" class="am-node-text">GH 指令</text></g><g class="am-node am-node--rect" data-key="gh wrapper" data-step="2"><rect class="am-node-shape" x="156.8" y="20" width="95.1" height="35" rx="3"/><text x="204.3" 